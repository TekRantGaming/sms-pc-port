-	GXLightObj light;
+	GXLightObj light = {};
 	Vec pos;
 	MTXMultVec(gfx->getViewMtx(), getLightPosition(lightIndex), &pos);
 	GXInitLightPos(&light, pos.x, pos.y, pos.z);
