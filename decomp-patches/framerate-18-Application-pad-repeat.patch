Reason: port: with frame_rate = 60 a held cursor in the pause menu and the talk choices auto-repeats at its 30 fps timing; the repeat delay and interval are counted in pad reads and set at boot from the 30 fps rate, and the pads are read once per displayed frame, so the cursor repeated twice as fast
--- a/src/System/Application.cpp
+++ b/src/System/Application.cpp
@@ -83,12 +83,50 @@ extern "C" int port_frame_rate;
 #include "port_framerate.h"
 f32 SMSGetVSyncTimesPerSec();
+f32 SMSGetAnmFrameRate();
+
+// At 120 fps the shared timing helpers use quarter-frame steps and
+// four frames per native count; the 60 fps case below uses half steps.
+// Port: TMarioGamePad::reset (in its constructor, at boot, at 30) sets the
+// menu auto-repeat to 20 / SMSGetAnmFrameRate() pad reads before the first
+// repeat and 6 / SMSGetAnmFrameRate() between repeats, i.e. 1/3 s and 1/10 s
+// at 30. The pads are read once per displayed frame, so at 60 a held cursor
+// in the pause menu and the talk choices repeated twice as fast. When the
+// rate changes, recompute both from the rate in force, as reset() would; a
+// held button's count is rescaled rather than restarted.
+static void portRescalePadRepeat(JUTGamePad::CButton& button, u32 delay,
+                                 u32 rate)
+{
+	if (button.mRepeatDelay != 0)
+		button.mRepeatCount = button.mRepeatCount * delay / button.mRepeatDelay;
+	button.mRepeatDelay = delay;
+	button.mRepeatRate  = rate;
+}
+
+static void portSetPadRepeat(TApplication* app)
+{
+	u32 delay = port_cvt_fp2unsigned(20.0f / SMSGetAnmFrameRate());
+	u32 rate  = port_cvt_fp2unsigned(6.0f / SMSGetAnmFrameRate());
+	for (int i = 0; i < 4; ++i) {
+		TMarioGamePad* pad = app->mGamePads[i];
+		if (pad == nullptr)
+			continue;
+		portRescalePadRepeat(pad->mButton, delay, rate);
+		if (pad->getPortNum() >= 0)
+			portRescalePadRepeat(JUTGamePad::mPadButton[pad->getPortNum()],
+			                     delay, rate);
+	}
+}
+
 static void portSetGameplayFrameRate(TApplication* app, bool gameplay)
 {
+	int was             = port_active_frame_rate;
 	port_active_frame_rate = gameplay ? port_frame_rate : 30;
 	port_high_fps_active = port_active_frame_rate > 30;
 	app->mDisplay->unk4C = port_vi_retrace_multiplier() * 60 / port_active_frame_rate;
 	// the root fader outlives directors; it was made with the boot-time rate
 	app->mFader->mRate = SMSGetVSyncTimesPerSec();
+	if (port_active_frame_rate != was)
+		portSetPadRepeat(app);
 }
 #endif
 
