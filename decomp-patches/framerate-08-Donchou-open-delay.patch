+#ifdef TARGET_PC
+// Port: with frame_rate = 60 calcRootMatrix (called on the calc-anim pass)
+// runs every frame, twice as often per second as at 30. Once both of its
+// switches are hit, the curtain holds Mario's input for 20 counts of unk14C
+// on that pass before it opens; at 60 the pause lasted half as long. Count
+// it once per 1/30 s: on the calc pass of every other frame at 60 (the
+// director counts one unk5C per tick, two a frame).
+extern "C" int port_fps60_active;
+static inline bool DonchouPortCalcStep()
+{
+	return !port_fps60_active || (gpMarDirector->unk5C & 2) != 0;
+}
+#endif
