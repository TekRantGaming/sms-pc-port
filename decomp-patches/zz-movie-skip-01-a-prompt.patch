+#ifdef TARGET_PC
+// Port: "(A) Skip" in the bottom-right corner while a movie plays; A ends it
+// at once (direct). '@' is the A button in the system font
+// (standard_fontEx.bfn), drawn green like the button.
+class TMovieSkipPrompt : public JDrama::TViewObj {
+public:
+	TMovieSkipPrompt(const TMovieDirector* director)
+	    : JDrama::TViewObj("MovieSkipPrompt")
+	    , mDirector(director)
+	{
+	}
+
+	virtual void perform(u32 cue, JDrama::TGraphics* graphics);
+
+	static bool shown(const TMovieDirector* director)
+	{
+		return director->unk30.check(0x1) && !director->unk30.check(0x2)
+		       && (director->unk1C == TMovieDirector::STATE_FADE_IN
+		           || director->unk1C == TMovieDirector::STATE_PLAYING);
+	}
+
+	const TMovieDirector* mDirector;
+};
+
+void TMovieSkipPrompt::perform(u32 cue, JDrama::TGraphics* graphics)
+{
+	if (!(cue & CUE_DRAW) || !gpSystemFont || !shown(mDirector))
+		return;
+
+	J2DOrthoGraph graph(graphics->getViewport());
+	graph.setup2D();
+
+	const int size = 22, margin = 18;
+	const JUtility::TColor shadow(0, 0, 0, 170), green(60, 200, 70, 255),
+	    white(255, 255, 255, 255);
+	J2DPrint shadowText(gpSystemFont, 0, -0x80000000, shadow, shadow);
+	J2DPrint buttonText(gpSystemFont, 0, -0x80000000, green, green);
+	J2DPrint labelText(gpSystemFont, 0, -0x80000000, white, white);
+	shadowText.setFontSize(size, size);
+	buttonText.setFontSize(size, size);
+	labelText.setFontSize(size, size);
+
+	// sms_gx centres 2D like this in a widescreen frame, which reaches
+	// past both sides of the 4:3 one by half its extra width: the corner is
+	// that far out.
+	f32 wide  = port_widescreen > 1.0f ? port_widescreen : 1.0f;
+	f32 right = SMSGetGameRenderWidth() * (1.0f + wide) * 0.5f - margin;
+	f32 buttonW = buttonText.getWidth("@");
+	f32 labelW  = labelText.getWidth(" Skip");
+	int x = (int)(right - buttonW - labelW);
+	int y = SMSGetGameRenderHeight() - margin - size;
+
+	shadowText.print(x + 2, y + 2, "@ Skip");
+	buttonText.print(x, y, "@");
+	labelText.print(x + (int)buttonW, y, " Skip");
+}
+#endif
