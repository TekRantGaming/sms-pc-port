 }
 
+#ifdef TARGET_PC
+// Port: perform counts mFreezeTimer (the fruit-kick stun) and mWaterHitTimer
+// (how long the HP meter stays up after a hit) down on every call, whatever
+// the cue. Shadow Mario gets one movement call per 1/120 s tick and three
+// per-frame calls (calc-anim, view/entry, draw): 4 + 3 = 7 per 1/30 s at 30,
+// but 4 + 6 = 10 at 60, so both timers ran out 30% sooner. Keep the tick
+// calls and count the per-frame ones on every other frame at 60 (the
+// director counts one unk5C per tick, two a frame).
+extern "C" int port_fps60_active;
+static inline bool EnemyMarioPortTimerStep(u32 cue)
+{
+	return !port_fps60_active || (cue & CUE_MOVE) != 0
+	    || (gpMarDirector->unk5C & 2) != 0;
+}
+#endif
