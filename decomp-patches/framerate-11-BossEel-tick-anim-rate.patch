+	    ->setRate(0.25f * BossEelPortTickAnmRate());
+#else
 	getMActor()
 	    ->getFrameCtrl(ANM_TYPE_BCK)
 	    ->setRate(0.25f * SMSGetAnmFrameRate());
+#endif
