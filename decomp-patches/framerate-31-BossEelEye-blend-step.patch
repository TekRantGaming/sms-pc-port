Reason: port: with frame_rate = 60 Eely-Mouth's eyes blend between animations at their 30 fps speed; the blend steps on the calc-anim pass, which comes every frame, so it finished in half the time
--- a/src/Enemy/bosseel.cpp
+++ b/src/Enemy/bosseel.cpp
@@ -1201,6 +1201,20 @@ static inline MActor* BosseelEyeMActor(TBossEelEye* p)
 	return actor;
 }
 
+#ifdef TARGET_PC
+// At 120 fps the shared timing helpers use quarter-frame steps and
+// four frames per native count; the 60 fps case below uses half steps.
+// Port: the eye's motion blend (mBlendRatio) falls 0.01 a calc-anim pass,
+// which with frame_rate = 60 comes every frame, twice as often per second
+// as at 30, so a new eye animation blended in in half the time. At 60 take
+// half a step, which keeps the blend per second and the motion smooth.
+#include "port_framerate.h"
+static inline f32 BossEelEyePortStep(f32 step)
+{
+	return port_frame_scale() * step;
+}
+#endif
