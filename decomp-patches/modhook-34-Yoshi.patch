+#ifdef TARGET_PC
+// TYoshi::disappear as retail inlines it into movement, with Eclipse's
+// isYoshiDie(mMario) (function t) called over the `lwz r0, 0x118(r3)` flag
+// read and `cmpwi r3, 0x0` / `beq` written after it: a Yoshi that dies always
+// drowns, and one that lives (2) leaves by that `beq` without its state
+// changed. 0 when not hatched, 1 when it disappeared.
+static inline int sms_mod_yoshiDisappear_(TYoshi* yoshi, void* t)
+{
+	if (!YoshiIsHatched(yoshi))
+		return 0;
+	if (yoshi->mState == TYoshi::STATE_MOUNTED)
+		yoshi->mMario->getOffYoshi(true);
+	if (!((bool (*)(TMario*))t)(yoshi->mMario))
+		return 2;
+	yoshi->mState = TYoshi::STATE_DROWNING;
+	yoshi->changeAnimation(MSD_SE_PO_SPREAD);
+	yoshi->mType = 0;
+	yoshi->unk2  = 30;
+	return 1;
+}
+#endif
