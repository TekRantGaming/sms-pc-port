Reason: port: with frame_rate = 60 the fruit boats sail their routes at their 30 fps speed; the route animation is stepped per 1/120 s tick (from the BckTrace nerve) at mSLBckMoveSpeed * SMSGetAnmFrameRate(), a per-frame rate that halves at 60 while the tick rate does not, so they sailed at half speed
--- a/src/Enemy/fruitsboat.cpp
+++ b/src/Enemy/fruitsboat.cpp
@@ -67,6 +67,22 @@ TFruitsBoat::TFruitsBoat(const char* name)
 	onLiveFlag(LIVE_FLAG_UNK10);
 }
 
+#ifdef TARGET_PC
+// Port: the track animation that carries the boat is stepped by
+// traceBckTrack from the TNerveFruitsBoatBckTrace nerve, i.e. from the
+// spine in moveObject, on every 1/120 s movement tick: four a frame at 30,
+// two at 60. Its rate is mSLBckMoveSpeed * SMSGetAnmFrameRate(), a
+// per-frame rate; with frame_rate = 60 SMSGetAnmFrameRate() halves while
+// the tick rate does not, so the fruit boats sailed their routes at half
+// speed. Use the 30 fps value.
+extern "C" int port_fps60_active;
+static inline f32 FruitsBoatPortTickAnmRate()
+{
+	f32 rate = SMSGetAnmFrameRate();
+	return port_fps60_active ? 2.0f * rate : rate;
+}
+#endif
+
 // Looks the requested animation up in the manager's shared .bck table and, if
 // it is there, drives it by hand through our own J3DFrameCtrl. Returns 0 on
 // success, -1 when the table has no such animation.
@@ -87,7 +103,11 @@ int TFruitsBoat::setBckTrack(const char* name)
 			// frame (`get()` instead of `.value` is +0x10 and overshoots).
 			TFruitsBoatParams* params = getSaveParams();
 			f32 speed                 = params->mSLBckMoveSpeed.value;
+#ifdef TARGET_PC
+			mBckTrackCtrl->setRate(speed * FruitsBoatPortTickAnmRate());
+#else
 			mBckTrackCtrl->setRate(speed * SMSGetAnmFrameRate());
+#endif
 			return 0;
 		}
 	}
