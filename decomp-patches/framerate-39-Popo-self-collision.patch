 bool TPopo::isCollidMove(THitActor* param_1)
 {
+#ifdef TARGET_PC
+	// calcRootMatrix refreshes mCollision on every displayed frame. At
+	// high frame rates it can catch this Puffer's own body, which otherwise
+	// receives its own trample message and enters the explosion nerve.
+	if (param_1 == this)
+		return false;
+#endif
+
 	if (mSpine->getCurrentNerve() == &TNervePopoFly::theNerve()
 	    && param_1->receiveMessage(this, HIT_MESSAGE_TRAMPLE))
 		mSpine->pushNerve(&TNervePopoExplosion::theNerve());
