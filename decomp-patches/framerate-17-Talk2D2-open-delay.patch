Reason: port: with frame_rate = 60 the talk window waits its 30 fps delay before opening; the 20-count wait and the page-erase fade step on the calc-anim pass, which comes every frame, so every talk window opened after 0.33 s instead of 0.67 s
--- a/src/GC2D/Talk2D2.cpp
+++ b/src/GC2D/Talk2D2.cpp
@@ -1137,6 +1137,21 @@ static inline void Talk2D2CalcAnim(TTalk2D2* p)
 	}
 }
 
+#ifdef TARGET_PC
+// Port: with frame_rate = 60 the talk window's calc-anim pass comes every
+// frame, twice as often per second as at 30, while its CUE_MOVE pass keeps
+// its 1/120 s ticks. The calc pass counts mWaitTimer (20) down before the
+// window opens and fades a page out 16 alpha at a time, so every talk window
+// opened after 0.33 s instead of 0.67 s. Step it once per 1/30 s: on the
+// calc pass of every other frame at 60 (the director counts one unk5C per
+// tick, two a frame).
+extern "C" int port_fps60_active;
+static inline bool Talk2D2PortCalcStep()
+{
+	return !port_fps60_active || (gpMarDirector->unk5C & 2) != 0;
+}
+#endif
+
 // TODO: frame 0x178 vs retail 0x1c8. SMSGetMarDirector() at the director
 // sites (as in openTalkWindow) moves it to 0x190 at no instruction change;
 // SMSGetMSoundBound() at the sound sites is inert here.
@@ -1213,6 +1228,9 @@ void TTalk2D2::perform(u32 cue, JDrama::TGraphics* graphics)
 	if (cue & CUE_CALC_ANIM) {
 		switch (gpMarDirector->unk124) {
 		case 2:
+#ifdef TARGET_PC
+			if (Talk2D2PortCalcStep())
+#endif
 			Talk2D2CalcAnim(this);
 			break;
 		}
