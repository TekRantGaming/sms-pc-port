+// A camera's isDemoCamera() with its isSimpleDemoCamera() call redirected to
+// a mod's function t (Eclipse's spoofCameraDemoForUI).
+static inline bool sms_mod_isDemoCamera_(void* t, CPolarSubCamera* camera)
+{
+	return ((bool (*)(CPolarSubCamera*))t)(camera) || camera->isBckDemoCamera() ? true
+	                                                                            : false;
+}
+
+// What a D-form `addi`/`addis`/`ori`/`oris` word w computes from src (the
+// value of its source register; rA = 0 reads 0 for addi/addis).
+static inline u32 sms_mod_dform_(u32 w, u32 src)
+{
+	u32 op = w >> 26, imm = w & 0xFFFF;
+	u32 base = ((w >> 16) & 31) ? src : 0;
+	switch (op) {
+	case 14: return base + (u32)(s32)(s16)imm;
+	case 15: return base + (imm << 16);
+	case 24: return src | imm;
+	case 25: return src | (imm << 16);
+	}
+	return src;
+}
+#endif
 
