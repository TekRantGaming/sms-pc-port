Reason: port: with frame_rate = 60 the Gelato Beach mirror hint (balloon 0x2E after 900 counts standing on a mirror) keeps its 30 s delay; it counted on the calc-anim pass, every frame, so at 60 it came after 15 s
--- a/src/Enemy/chuuhana.cpp
+++ b/src/Enemy/chuuhana.cpp
@@ -117,6 +117,21 @@ static inline TGCConsole2* ChuuHanaGetConsole()
 	return console;
 }
 
+#ifdef TARGET_PC
+// Port: with frame_rate = 60 the calc-anim pass (CUE_CALC_ANIM) comes every
+// frame, twice as often per second as at 30, while the movement pass keeps
+// its 1/120 s ticks. unk60 counts the time Mario has stood on one of the
+// Gelato Beach mirrors on that pass and brings up hint 0x2E at 900 (30 s at
+// 30), so at 60 the hint came after 15 s. Count it once per 1/30 s: on the
+// calc pass of every other frame at 60 (the director counts one unk5C per
+// tick, two a frame).
+extern "C" int port_fps60_active;
+static inline bool ChuuHanaManagerPortCalcStep()
+{
+	return !port_fps60_active || (gpMarDirector->unk5C & 2) != 0;
+}
+#endif
+
 void TChuuHanaManager::perform(u32 cue, JDrama::TGraphics* graphics)
 {
 	// Hint balloons: standing on a panel long enough, a tackle, repeated
@@ -125,7 +140,11 @@ void TChuuHanaManager::perform(u32 cue, JDrama::TGraphics* graphics)
 		if (SMS_GetMarioGrPlane()->getActor()
 		    && SMS_GetMarioGrPlane()->getActor()->getActorType()
 		        == 0x400000CF) {
+#ifdef TARGET_PC
+			if (unk60 < 900 && ChuuHanaManagerPortCalcStep()) {
+#else
 			if (unk60 < 900) {
+#endif
 				unk60++;
 				if (unk60 == 900)
 					ChuuHanaGetConsole()->startAppearBalloon(0x2E, true);
