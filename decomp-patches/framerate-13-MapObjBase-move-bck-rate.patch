+#ifdef TARGET_PC
+// Port: a map object with move data (mMapObjData->mMove: the TurnLift,
+// yTurnLift and zTurnDisk platforms) follows that animation in
+// TMapObjBase::control, which steps move->unk8 on every 1/120 s movement
+// tick: four a frame at 30, two at 60. Its rate, SMSGetAnmFrameRate(), is a
+// per-frame rate; with frame_rate = 60 it halves while the tick rate does
+// not, so these platforms moved at half speed. Use the 30 fps value.
+extern "C" int port_fps60_active;
+static inline f32 MapObjInitPortTickAnmRate()
+{
+	f32 rate = SMSGetAnmFrameRate();
+	return port_fps60_active ? 2.0f * rate : rate;
+}
+#endif
