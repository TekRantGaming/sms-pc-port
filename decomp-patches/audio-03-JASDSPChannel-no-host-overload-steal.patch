Reason: Audio: TDSPChannel::updateAll steals the lowest active voice when OSGetTick gaps between subframe updates suggest the DSP is overloaded; on the port those gaps are host scheduling, and the guard cut most music notes to a third of their retail length (measured against Dolphin LLE voice-block traces). Skip it on TARGET_PC.
--- a/libs/JSystem/src/JAudio/JASystem/JASDSPChannel.cpp
+++ b/libs/JSystem/src/JAudio/JASystem/JASDSPChannel.cpp
@@ -255,9 +255,17 @@
 		old_time      = time;
 		u32 var2      = 7 - AudioThread::getDSPSyncCount();
 		history[var2] = delta;
+#ifndef TARGET_PC
+		// DSP overload guard: the gap before a frame's first subframe against
+		// the time the DSP took for the next one.
 		if (var2)
 			if (f32(history[0]) / delta < DSP_LIMIT_RATIO)
 				breakLowerActive(126);
+#endif
+		// TARGET_PC: the software mixer renders a subframe in microseconds, so
+		// these host-time gaps measure thread scheduling (the audio thread
+		// waiting for the emulated CPU), not DSP load; the guard fired
+		// constantly and cut notes short.
 	}
 
 	for (u32 i = 0; i < 64; i++) {
