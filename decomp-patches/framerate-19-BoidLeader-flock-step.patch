 			JGeometry::TVec3<f32> force = calcForces(b);
 			if (!force.isZero()) {
+#ifdef TARGET_PC
+				if (force.y < -0.01f) {
+					b->mRotation.x += BoidPortStep(mPitchSpeed);
+					if (b->mRotation.x > mMaxPitch)
+						b->mRotation.x = mMaxPitch;
+				} else if (force.y > 0.01f) {
+					b->mRotation.x -= BoidPortStep(mPitchSpeed);
+					if (b->mRotation.x < -mMaxPitch)
+						b->mRotation.x = -mMaxPitch;
+				} else {
+					b->mRotation.x *= BoidPortPitchDecay();
+				}
+
+				f32 targetYaw = MsGetRotFromZaxisY(force);
+				f32 diff      = MsAngleDiff(targetYaw, b->mRotation.y);
+				if (diff < -0.01f)
+					diff = -BoidPortStep(mYawSpeed);
+				else if (diff > 0.01f)
+					diff = BoidPortStep(mYawSpeed);
+#else
 				if (force.y < -0.01f) {
 					b->mRotation.x += mPitchSpeed;
 					if (b->mRotation.x > mMaxPitch)
@@ -129,6 +170,7 @@ void TBoidLeader::calcBoids()
