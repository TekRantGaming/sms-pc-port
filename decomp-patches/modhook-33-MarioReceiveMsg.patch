+#ifdef TARGET_PC
+// getNozzle as retail inlines it into receiveMessage, for the pickup sites a
+// code mod patches: onYoshiFn (bool (*)(TMario*)) replaces its onYoshi()
+// call, or noYoshiTest drops that test; changeNozzleFn
+// (void (*)(TWaterGun*, int, bool)) replaces its changeNozzle call.
+static bool MarioGetNozzleModded(TMario* mario, THitActor* sender,
+                                 TWaterGun::TNozzleType type, void* onYoshiFn,
+                                 bool noYoshiTest, void* changeNozzleFn)
+{
+	if (!noYoshiTest
+	    && (onYoshiFn ? ((bool (*)(TMario*))onYoshiFn)(mario)
+	                  : (bool)mario->onYoshi()))
+		return FALSE;
+	mario->onFlag(MARIO_FLAG_HAS_FLUDD);
+	if (mario->checkFlag(MARIO_FLAG_HAS_FLUDD)) {
+		if (changeNozzleFn)
+			((void (*)(TWaterGun*, int, bool))changeNozzleFn)(mario->mWaterGun,
+			                                                  type, true);
+		else
+			mario->mWaterGun->changeNozzle(type, true);
+	}
+
+	mario->unk144 = 3600;
+	mario->resetNozzle();
+	mario->unk148 = sender;
+	if (mario->checkFlag(MARIO_FLAG_HAS_FLUDD))
+		mario->mWaterGun->resetWaterToFull();
+
+	mario->emitGetEffect();
+	return TRUE;
+}
+#endif
