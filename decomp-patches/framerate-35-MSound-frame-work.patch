 extern OSThread gSetupThread;
 
+#ifdef TARGET_PC
+// Port: MSound::mainLoop does JAI's frame work every other frame at
+// frame_rate = 60 (see MSound.cpp), so a fade given in frames must be given
+// in 30 fps frames. The stage-exit fade below is the one gameplay caller
+// that scales its length by SMSGetVSyncTimesPerSec(); at 60 that asked for
+// 24 frames of work, 0.8 s. Halve it to keep its 0.4 s.
+extern "C" int port_fps60_active;
+static inline f32 MarDirectorPortSoundFrames(f32 frames)
+{
+	return port_fps60_active ? 0.5f * frames : frames;
+}
+#endif
