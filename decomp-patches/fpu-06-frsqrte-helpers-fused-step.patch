+++ b/libs/JSystem/include/JSystem/JGeometry/JGUtil.hpp
@@ -61,20 +61,12 @@
 
 	static f32 sqrt(f32 mag)
 	{
-		if (mag <= 0.0f)
-			return mag;
-
-		f32 root = __frsqrte(mag);
-		return 0.5f * root * (3.0f - mag * (root * root)) * mag;
+		return sms_jg_sqrtf(mag);
 	}
 
 	static f32 inv_sqrt(f32 mag)
 	{
-		if (mag <= 0.0f)
-			return mag;
-
-		f32 root = __frsqrte(mag);
-		return 0.5f * root * (3.0f - mag * (root * root));
+		return sms_jg_inv_sqrtf(mag);
 	}
 };
 
