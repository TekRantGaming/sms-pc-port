+// A 3-float vector passed by value the way a mod function declared with
+// SunshineHeaderInterface's TVec3f (trivially copyable) takes it; the decomp's
+// TVec3 has a user-provided copy constructor, so it would go by reference.
+struct SmsModVec3 {
+	f32 x, y, z;
+};
+
+// fenceFootCheck as retail inlines it into fenceJumpCatch (specMain), with its
+// checkWallPlane call at retail 0x8025DD84 going to what a mod registered
+// there (`site`): BetterSunshineEngine's and Eclipse's checkClimbingWallPlane
+// take (player, pos by value, width, height).
+static void smsFenceFootCheckAt(TMario* mario, void* site)
+{
+	JGeometry::TVec3<f32> front = mario->mPosition;
+	front.x += 0.8f * (50.0f * JMASSin(mario->mFaceAngle.y));
+	front.z += 0.8f * (50.0f * JMASCos(mario->mFaceAngle.y));
+	SmsModVec3 pos = { front.x, front.y, front.z };
+	if (((TBGCheckData* (*)(TMario*, SmsModVec3, f32, f32))site)(mario, pos,
+	                                                            20.0f, 50.0f)
+	    == nullptr) {
+		mario->mFaceAngle.y += 0x8000;
+		mario->setPlayerVelocity(0.0f);
+		mario->mVel.y = 0.0f;
+		mario->changePlayerStatus(MARIO_STATUS_LAND_SAFE_DOWN, 0, false);
+	}
+}
+#endif
 
