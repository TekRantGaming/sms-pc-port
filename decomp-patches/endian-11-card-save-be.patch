 #include <dolphin/os.h>
 #include <string.h>
 
+#ifdef TARGET_PC
+// Memory-card data keeps retail's big-endian layout.
+static void port_write_be(JSUMemoryOutputStream& out, const void* p, int size, int width)
+{
+	for (int o = 0; o < size; o += width) {
+		u8 tmp[8];
+		for (int i = 0; i < width; i++)
+			tmp[i] = ((const u8*)p)[o + width - 1 - i];
+		out.write(tmp, width);
+	}
+}
+static void port_swap_in_place(void* p, int size, int width)
+{
+	u8* b = (u8*)p;
+	for (int o = 0; o < size; o += width)
+		for (int i = 0; i < width / 2; i++) {
+			u8 t                 = b[o + i];
+			b[o + i]             = b[o + width - 1 - i];
+			b[o + width - 1 - i] = t;
+		}
+}
+#define PORT_WRITE_BE(out, p, size, width) port_write_be(out, p, size, width)
+#endif
