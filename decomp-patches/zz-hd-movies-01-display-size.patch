Reason: port: fit movies to the displayed frame, widened with SMS_WIDESCREEN: HD overrides keep the original footprint at 4:3, and every movie fills the wide frame in its own shape, which sms_gx stretches the movie draw across
--- a/src/System/MovieDirector.cpp
+++ b/src/System/MovieDirector.cpp
@@ -184,6 +184,13 @@
 {
 }
 
+#ifdef TARGET_PC
+// SMS_WIDESCREEN (platform): the displayed width over the GameCube's 4:3, 1
+// when off. Movies fill that frame (rsetup); TTHPRender has sms_gx stretch
+// them.
+extern "C" float port_widescreen;
+#endif
+
 void* TMovieDirector::setupThreadFunc(void* self)
 {
 	((TMovieDirector*)self)->rsetup();
@@ -341,6 +348,26 @@
 
 	THPVideoInfo videoInfo;
 	THPPlayerGetVideoInfo(&videoInfo);
+#ifdef TARGET_PC
+	// Full-frame movies (the originals and HD overrides) fit the displayed
+	// frame, widened by port_widescreen, keeping their shape: without
+	// widescreen an HD movie keeps the original's footprint. TTHPRender has
+	// sms_gx stretch every movie by port_widescreen, so its game-space width
+	// is narrower by that much. Only this display copy changes; the player
+	// still decodes the full size.
+	{
+		double wide = port_widescreen > 1.0f ? port_widescreen : 1.0;
+		double scale = 1.0;
+		if (videoInfo.xSize >= SMSGetGameRenderWidth()
+		    || videoInfo.ySize > SMSGetGameRenderHeight()) {
+			scale = SMSGetGameRenderWidth() * wide / videoInfo.xSize;
+			if ((double)SMSGetGameRenderHeight() / videoInfo.ySize < scale)
+				scale = (double)SMSGetGameRenderHeight() / videoInfo.ySize;
+		}
+		videoInfo.xSize = (u32)(videoInfo.xSize * scale / wide + 0.5);
+		videoInfo.ySize = (u32)(videoInfo.ySize * scale + 0.5);
+	}
+#endif
 
 	thpRender->mPos = JGeometry::TVec2<u32>(
 	    (SMSGetGameRenderWidth() - videoInfo.xSize) / 2,
