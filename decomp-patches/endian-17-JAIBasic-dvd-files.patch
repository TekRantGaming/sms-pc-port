 }
 
+#ifdef TARGET_PC
+// Files JAudio reads straight from the disc (a mod's /AudioRes/msound.aaf, the
+// JaiInit.bld list) are big-endian like the archived ones: converted by name
+// (platform/endian).
+extern "C" void port_res_to_native_named(void* data, u32 size, const char* name);
+#endif
