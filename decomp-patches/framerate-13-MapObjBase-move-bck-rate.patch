Reason: port: with frame_rate = 60 map objects driven by move data (TurnLift, yTurnLift, zTurnDisk) turn at their 30 fps speed; TMapObjBase::control steps the move animation per 1/120 s tick at SMSGetAnmFrameRate(), a per-frame rate that halves at 60 while the tick rate does not, so they turned at half speed
--- a/src/MoveBG/MapObjBase.cpp
+++ b/src/MoveBG/MapObjBase.cpp
@@ -361,6 +361,17 @@ static inline MSound* MOBSound()
 	return sound;
 }
 
+#ifdef TARGET_PC
+// Port: see initBckMoveData (MapObjInit.cpp): control() steps this frame
+// control once per 1/120 s tick, so it wants the 30 fps per-frame rate.
+extern "C" int port_fps60_active;
+static inline f32 MapObjBasePortTickAnmRate()
+{
+	f32 rate = SMSGetAnmFrameRate();
+	return port_fps60_active ? 2.0f * rate : rate;
+}
+#endif
