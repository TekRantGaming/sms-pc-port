+#ifdef TARGET_PC
+// Button prompts (platform gx_prompts.cpp): an RGBA8 64x64 image to draw for a
+// system-font button glyph (A B X Y Z L R C-stick) in the style of the
+// controller in use, or null to keep the font's own glyph.
+extern "C" const void* port_button_glyph(int chr);
+extern JUTResFont* gpSystemFont;
+// setGX(col1, col2) set up the two-colour TEV, which maps the texture's
+// intensity between two colours; the prompt images are drawn in their own
+// colours, so drawChar_scale switches to plain modulate for them and back.
+static bool sPortTwoColour;
+static JUtility::TColor sPortCol1, sPortCol2;
+static u32 portPromptColour(u32 c)
+{
+	u32 sum = (c >> 24) + ((c >> 16) & 0xFF) + ((c >> 8) & 0xFF);
+	return sum < 3 * 0x60 ? c : (c & 0xFF) | 0xFFFFFF00;
+}
+#endif
