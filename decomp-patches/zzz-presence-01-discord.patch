+#ifdef TARGET_PC
+#include "port_presence.h"
+
+// Port: what Discord shows (platform/presence), read once a frame. The flag
+// manager exists from the setup thread on; the director only in gameplay.
+static void ApplicationPresenceFrame(TApplication* app)
+{
+	PortPresence p;
+	TFlagManager* flags = TFlagManager::smInstance;
+	TMarDirector* dir
+	    = app->mAppState == TApplication::APP_STATE_GAMEPLAY ? gpMarDirector : nullptr;
+	p.state     = app->mAppState;
+	p.area      = app->mCurrArea.getStage();
+	p.episode   = flags ? flags->getFlag(0x40003) : 0;
+	p.shines    = flags ? flags->getFlag(0x40000) : 0;
+	p.blueCoins = flags ? flags->getFlag(0x40001) : 0;
+	p.lives     = flags ? flags->getFlag(0x20001) : 0;
+	p.saveFile  = app->mSaveFile;
+	p.paused    = dir && dir->mState == TMarDirector::STATE_PAUSE_MENU;
+	p.cutscene  = dir && dir->isDemoModeNow();
+	port_presence_frame(&p);
+}
+#endif
