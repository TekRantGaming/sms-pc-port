+// What `rlwinm` word w computes from v (a mod rewrote a mask instruction).
+static inline u32 sms_mod_rlwinm_(u32 w, u32 v)
+{
+	u32 sh = (w >> 11) & 31, mb = (w >> 6) & 31, me = (w >> 1) & 31;
+	u32 r    = sh ? ((v << sh) | (v >> (32 - sh))) : v;
+	u32 lo   = 0xFFFFFFFFu >> mb, hi = 0xFFFFFFFFu << (31 - me);
+	return r & (mb <= me ? (lo & hi) : (lo | hi));
+}
+
+// BetterSunshineEngine replaces this TU's copy of SMS_getShineID (retail
+// 0x8016FAC0, a `b` to its own SMS_getShineID(u32, u32, bool) returning s32
+// in r3); the header's static copy runs otherwise.
+static s32 sms_mod_getShineID_(u32 stage, u32 scenario, bool is_etc_shine)
+{
+	if (void* sms_mod_t_ = SMS_MOD_SITE(0x8016FAC0))
+		return ((s32(*)(u32, u32, bool))sms_mod_t_)(stage, scenario, is_etc_shine);
+	return SMS_getShineID(stage, scenario, is_etc_shine);
+}
+
+// SMS_isGetShine as retail inlines it here, at the site whose
+// `clrlwi r4, r3, 24` (the shine id passed to getShineFlag) sits at `addr`:
+// BetterSunshineEngine rewrites that word to `clrlwi r4, r3, 16` (words at
+// 0x8016DD1C, 0x8016DEA8, 0x8016DF1C, 0x8016E204, 0x8016F6DC) so that shine
+// ids above 0xFF reach its widened getShineFlag.
+// TODO: TFlagManager::getShineFlag still takes a u8, so the upper bits of a
+// widened id are dropped at the call until its parameter is widened too.
+static bool sms_mod_isGetShine_(u32 addr, u32 stage, u32 scenario, bool is_etc_shine)
+{
+	unsigned int w;
+	bool masked = sms_mod_word(addr, &w);
+	if (!masked && !SMS_MOD_SITE(0x8016FAC0))
+		return SMS_isGetShine(stage, scenario, is_etc_shine);
+	s32 id = sms_mod_getShineID_(stage, scenario, is_etc_shine);
+	if ((s16)id == -1)
+		return false;
+	return TFlagManager::getInstance()->getShineFlag(
+	    masked ? sms_mod_rlwinm_(w, (u32)id) : (u8)id);
+}
+#endif
 
