+// BetterSunshineEngine replaces this object's copy of SMS_getShineID
+// (SMS_PATCH_B at retail 0x8017CC6C, its first instruction; the mod's
+// returns an s32 whose low half the callers sign-extend). Retail calls it
+// only from resetObjects' SMS_isGetShine expansions, whose getShineFlag
+// argument the words at 0x8017BE78, 0x8017BEF4, 0x8017BF34 and 0x8017BFB4
+// (`clrlwi r4, r3, 16`) mask to 16 bits instead of 8; the port's
+// getShineFlag takes a u8 (as TFlagManager's own hooks keep it), which holds
+// every id Eclipse registers (the highest is 220).
+static inline bool GuideIsGetShine(u32 stage, u32 scenario, bool is_etc_shine)
+{
+	void* sms_mod_t_ = SMS_MOD_SITE(0x8017CC6C);
+	if (!sms_mod_t_)
+		return SMS_isGetShine(stage, scenario, is_etc_shine);
+	s16 shineId = (s16)((s32(*)(u32, u32, bool))sms_mod_t_)(stage, scenario, is_etc_shine);
+	if (shineId == -1)
+		return false;
+	return TFlagManager::getInstance()->getShineFlag(shineId);
+}
+#endif
 
