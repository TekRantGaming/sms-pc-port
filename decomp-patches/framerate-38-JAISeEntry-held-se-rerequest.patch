+#ifdef TARGET_PC
+// At 60 or 120 fps MSound::mainLoop does JAI's frame work on one displayed
+// frame of each two or four (framerate-35), so a held sound (no 0xC00 bits),
+// which the game asks for again on every displayed frame to keep it going, is
+// asked for more than once per frame work. The first request re-arms it
+// (Stopping -> Playing, below); retail treats a second one as a new start and
+// stops the playing sound. Retail never sends two: TMarDirector::direct clears
+// the continuous SE gate on every simulation tick but the last. So the charge
+// sound (MSD_SE_SY_NEWP_AIR_TAME) restarted every other frame work and was
+// never heard, and each stop raised its track's interrupt switch, whose port
+// command, queued a second time in the same frame work, cut the commands
+// queued after it off cmd_once, among them the BGM volume and pan updates
+// (Shadow Mario's distance fade). A held sound already re-armed since the last
+// frame work keeps playing.
+#include "port_framerate.h"
+static inline bool JAISeEntryPortRearmed(const JAISound* sound, u32 sound_id)
+{
+	return port_high_fps_active && (sound_id & 0xC00) == 0
+	    && sound->mState == SOUNDSTATE_Playing;
+}
+#endif
