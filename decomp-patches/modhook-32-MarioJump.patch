+// checkBackTrig as retail inlines it into jumpMain's handlers, stayWall and
+// landing: each inlined copy has its own setPlayerVelocity call, which a mod
+// may redirect on its own (moveset's uncapDiveAirSpeed at 0x802496AC,
+// 0x8024976C, 0x8024999C, 0x80249C70 and 0x8024C284; it reads the player from
+// r30, which holds `this` at all of them). `site` is what is registered at the
+// copy's call, or null for a copy no mod touches.
+static BOOL smsCheckBackTrigAt(TMario* mario, void* site)
+{
+	if (mario->mInput & 0x8000) {
+		if (mario->mGamePad->mEnabledFrameMeaning & 0x2000) {
+			return mario->changePlayerStatus(MARIO_STATUS_HIP_DROP, 0, 0);
+		}
+		if (mario->onYoshi() == 0) {
+			if (site) {
+				SMS_MOD_GPR(30, mario);
+				((void (*)(f32))site)(mario->mJumpParams.mJumpJumpCatchSp.get());
+			} else {
+				mario->setPlayerVelocity(mario->mJumpParams.mJumpJumpCatchSp.get());
+			}
+			return mario->changePlayerStatus(MARIO_STATUS_JUMP_CATCH, 0, 0);
+		}
+	}
+	return 0;
+}
+#endif
 
