Reason: port: with frame_rate = 60 the plaza gates' radial blur (TAfterEffect, fed by TModelGate::screenBlur) fades in and out at its 30 fps speed; both chase their targets by a fixed part of the gap once per drawn frame, so the blur came and went twice as fast
--- a/src/MarioUtil/ScreenUtil.cpp
+++ b/src/MarioUtil/ScreenUtil.cpp
@@ -89,6 +89,24 @@
 	unk15 = 0;
 }
 
+#ifdef TARGET_PC
+#include <math.h>
+
+// Port: perform (on CUE_SET_PROJECTION, once per drawn frame) chases the
+// blur's alphas, offsets and scales towards their targets by unk48 (0.05) of
+// the gap a call. With frame_rate = 60 that comes twice as often per second
+// as at 30, so the plaza gates' radial blur came and went twice as fast. At
+// 60 chase by 1 - sqrt(1 - unk48), which closes the same part of the gap per
+// second and keeps the motion smooth. (The dash-blur countdown in
+// calcDashBlurValue is only reached through TMario::thinkDashEffect, which
+// is empty in retail, so it is left alone.)
+extern "C" int port_fps60_active;
+static inline f32 AfterEffectPortChase(f32 rate)
+{
+	return port_fps60_active ? 1.0f - std::sqrtf(1.0f - rate) : rate;
+}
+#endif
