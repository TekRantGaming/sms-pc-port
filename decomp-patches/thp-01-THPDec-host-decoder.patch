+// Bit reader with the GameCube decoder's state: info->c points at the
+// current big-endian word, info->currByte holds it, info->cnt is the 1-based
+// position of the next bit (33 = word exhausted).
+static u32 port_thp_bit(THPFileInfo* info)
+{
+	if (info->cnt > 32) {
+		info->c += 4;
+		info->currByte = port_be32(info->c);
+		info->cnt      = 1;
+	}
+	return (info->currByte >> (32 - info->cnt++)) & 1;
+}
+
+static s32 port_thp_bits(THPFileInfo* info, s32 n)
+{
+	s32 v = 0;
+	while (n--)
+		v = (v << 1) | (s32)port_thp_bit(info);
+	return v;
+}
+
+s32 __THPHuffDecodeTab(THPFileInfo* info, THPHuffmanTab* h)
+{
+	s32 code = 0;
+	s32 l;
+	for (l = 1; l <= 16; l++) {
+		code = (code << 1) | (s32)port_thp_bit(info);
+		if (code <= h->maxCode[l])
+			return h->Vij[code + h->valPtr[l]];
+	}
+	return 0;
+}
+
+static s32 port_thp_extend(s32 v, s32 s)
+{
+	return v < (1 << (s - 1)) ? v + (-1 << s) + 1 : v;
+}
+
+static void port_thp_block(THPFileInfo* info, THPCoeff* block, THPHuffmanTab* dc,
+                           THPHuffmanTab* ac, THPComponent* comp)
+{
+	s32 t, k;
+	memset(block, 0, 64 * sizeof(THPCoeff));
+	t = __THPHuffDecodeTab(info, dc);
+	if (t)
+		comp->predDC = (s16)(comp->predDC + port_thp_extend(port_thp_bits(info, t), t));
+	block[0] = comp->predDC;
+	for (k = 1; k < 64; k++) {
+		s32 rs = __THPHuffDecodeTab(info, ac);
+		s32 r = rs >> 4, sz = rs & 15;
+		if (sz) {
+			k += r;
+			block[__THPJpegNaturalOrder[k]] = (THPCoeff)port_thp_extend(port_thp_bits(info, sz), sz);
+		} else {
+			if (r != 15)
+				break;
+			k += 15;
+		}
+	}
+}
+#endif
 
