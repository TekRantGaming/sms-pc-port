 bool TFlagManager::getShineFlag(u8 shine) const
 {
+#ifdef TARGET_PC
+	// BetterSunshineEngine (words at retail 0x80294730, 0x80294734,
+	// 0x80294744): the clamp tests the low 16 bits against another limit and
+	// the u8 mask before the flag add is a nop; the port's shine is a u8, so
+	// only the limit (the cmplwi immediate) changes anything here.
+	unsigned int sms_mod_w_;
+	u32 sms_mod_limit_ = 120;
+	if (sms_mod_word(0x80294734, &sms_mod_w_) && (sms_mod_w_ >> 16) == 0x2800)
+		sms_mod_limit_ = sms_mod_w_ & 0xFFFF;
+	if (shine >= sms_mod_limit_) {
+		shine = 0;
+	}
+#else
 	if (shine >= 120) {
 		shine = 0;
 	}
+#endif
 	return getFlag(shine + 0x10000) != 0;
 }
 
