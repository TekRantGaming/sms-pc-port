 #include <System/DummyStrings.hpp>
 #include <Player/MarioDirtyStrings.hpp>
 
+#ifdef TARGET_PC
+#include <sms_modhook.h>
+
+// A model's load flags, rewritten by a code mod: retail loads them with
+// `lis r4, flags >> 16` right before J3DModelLoaderDataBase::load; a mod
+// writing another `lis r4, imm` there (BetterSunshineEngine, 0x3C801130:
+// animated textures) loads imm << 16 instead.
+static inline u32 MarioCapLoadFlags(unsigned int addr, u32 flags)
+{
+	unsigned int w;
+	if (sms_mod_word(addr, &w) && (w & 0xFFFF0000) == 0x3C800000)
+		return (w & 0xFFFF) << 16;
+	return flags;
+}
+#endif
