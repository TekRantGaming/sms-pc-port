Reason: Retail out-of-bounds access: a root directory's ".." entry (0xFFFFFFFF) makes findFsResource and findDirectory read the 16 bytes before the directory table as a directory, which on the console has no entries, so retail finds nothing; the port's tables differ there and a 64-bit host faults (Super Mario Eclipse's Red Lily: Shadow Mario's ../map/pad/Setting.prm from the params archive's root). Such an index finds nothing, as on the console.
--- a/libs/JSystem/src/JKernel/JKRArchivePri.cpp
+++ b/libs/JSystem/src/JKernel/JKRArchivePri.cpp
@@ -71,6 +71,11 @@
 	}
 
 	CArcName arcName(&name, '/');
+#ifdef TARGET_PC
+	// see findFsResource
+	if (directoryId >= mArcInfoBlock->num_nodes)
+		return nullptr;
+#endif
 	SDIDirEntry* dirEntry   = mDirectories + directoryId;
 	SDIFileEntry* fileEntry = mFileEntries + dirEntry->mFirstIdx;
 
