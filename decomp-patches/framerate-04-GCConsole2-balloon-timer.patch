+#ifdef TARGET_PC
+// Port: with frame_rate = 60 the HUD's calc-anim pass (flags & 2, where the
+// balloon is updated) comes every frame, twice as often per second as at 30,
+// while the movement pass keeps its 1/120 s ticks. The balloon's state
+// machine steps on that pass: its fade and grow (0x30 alpha, unk3CC rows a
+// pass), the text typed out two characters a pass, and the display timer
+// (unk3E4, len * 0.7 + 100 counts, 150 for message 0x2C), so every hint
+// balloon typed, stayed up and closed in half its time. Step it once per
+// 1/30 s: on the calc pass of every other frame at 60 (the director counts
+// one unk5C per tick, two a frame). The counters below still run every pass.
+extern "C" int port_fps60_active;
+static inline bool GCConsole2PortCalcStep()
+{
+	return !port_fps60_active || (gpMarDirector->unk5C & 2) != 0;
+}
+#endif
