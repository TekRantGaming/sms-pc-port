--- a/libs/JSystem/src/J3D/J3DGraphLoader/J3DAnmLoader.cpp
+++ b/libs/JSystem/src/J3D/J3DGraphLoader/J3DAnmLoader.cpp
@@ -217,11 +217,13 @@
