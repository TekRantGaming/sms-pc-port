Reason: MinGW's _tolower assumes an uppercase input; resource volume paths are already lowercase, so it corrupts names such as subtitle.
--- a/libs/JSystem/src/JKernel/JKRFileLoader.cpp
+++ b/libs/JSystem/src/JKernel/JKRFileLoader.cpp
@@ -186,7 +186,7 @@
 		path++;
 		while (*path != 0 && *path != '/') {
 			if (1 < bufferSize) {
-				*buffer = _tolower(*path);
+				*buffer = tolower((unsigned char)*path);
 				buffer++;
 				bufferSize--;
 			}
