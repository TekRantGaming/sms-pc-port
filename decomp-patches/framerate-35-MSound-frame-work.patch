Reason: port: with frame_rate = 60 the game's sound frame work (MSound::mainLoop: JAI fades and volume moves, sound-set repeat intervals, dummy-position lifetimes) keeps its 30 fps timing; it counts displayed frames, so every fade, interval and lifetime ran twice as fast; the stage-exit fade, the one gameplay caller that scales its length by the frame rate, is given in 30 fps frames
--- a/src/MSound/MSound.cpp
+++ b/src/MSound/MSound.cpp
@@ -597,8 +597,37 @@
 
 void MSound::requestShineAppearFanfare() { }
 
+#ifdef TARGET_PC
+// Port: TApplication::gameLoop calls mainLoop once per displayed frame, and
+// its work is counted in those calls: MSSetSound's repeat intervals, JAI's
+// sequence and SE volume moves and fades (given in frames by the game, e.g.
+// pauseOn's 60), the dummy-position lifetimes that stop a sound when they
+// run out, and the play-frame counters. With frame_rate = 60 every one of
+// them ran twice as fast. At 60 do the work on every other call, which is
+// the 30 fps timing; requests made in between wait at most 1/60 s. This is
+// all on the game thread; the audio thread is untouched. (The entrance-demo
+// counter, unkA4, only feeds MSMainProc::entranceDemoLoop, which is empty
+// in retail: 4 bytes in the map.)
+extern "C" int port_fps60_active;
+static inline bool MSoundPortSkipFrame()
+{
+	static bool skip;
+	if (!port_fps60_active) {
+		skip = false;
+		return false;
+	}
+	bool result = skip;
+	skip        = !skip;
+	return result;
+}
+#endif
+
 void MSound::mainLoop()
 {
+#ifdef TARGET_PC
+	if (MSoundPortSkipFrame())
+		return;
+#endif
 	if (unkCF == 0 && mSeGateMask == 0)
 		return;
 
