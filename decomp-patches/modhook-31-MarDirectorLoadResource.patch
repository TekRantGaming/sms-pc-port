+#ifdef TARGET_PC
+// SMS_LoadParticle whose load call a code mod redirects at retail `addr`;
+// the mod's function gets the load's arguments (manager, path, id) as the
+// type `fnType` it declares.
+#define SMS_MOD_LOAD_PARTICLE(addr, fnType, path, id)                                             \
+	do {                                                                                           \
+		if (!gParticleFlagLoaded[id]) {                                                            \
+			if (void* sms_mod_t_ = SMS_MOD_SITE(addr))                                             \
+				((fnType)sms_mod_t_)(gpResourceManager, path, id);                                 \
+			else                                                                                   \
+				gpResourceManager->load(path, id);                                                 \
+			gParticleFlagLoaded[id] = true;                                                        \
+		}                                                                                          \
+	} while (0)
+#endif
