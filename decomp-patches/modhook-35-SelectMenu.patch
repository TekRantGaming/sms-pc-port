+// BetterSunshineEngine's shine select (bse/src/area.cpp). Its
+// doScenarioCountPatches (initData, retail 0x80174540) gives each area its
+// own scenario count: it moves mShineMarks (0xDC) and mShineUnlockStates
+// (0x150) of TSelectMenu, and TSelectShineManager::mShines (0x10), to heap
+// arrays whose pointers it keeps in their first word, and rewrites the
+// instructions that index them (`lwz r12, 0xDC(r31); lwzx r3, r12, r3` and
+// the like) to go through those pointers. Each access below names the
+// rewritten words and reads through the pointer once they are in place.
+static inline J2DPicture** SelectMenuMarks(TSelectMenu* menu, unsigned int addr)
+{
+	unsigned int w;
+	return sms_mod_word(addr, &w) ? *(J2DPicture***)menu->mShineMarks : menu->mShineMarks;
+}
+
+static inline u8* SelectMenuStates(TSelectMenu* menu, unsigned int addr)
+{
+	unsigned int w;
+	return sms_mod_word(addr, &w) ? *(u8**)menu->mShineUnlockStates : menu->mShineUnlockStates;
+}
+
+static inline TSelectShine** SelectMenuShines(TSelectShineManager* mgr, unsigned int addr)
+{
+	unsigned int w;
+	return sms_mod_word(addr, &w) ? *(TSelectShine***)mgr->mShines : mgr->mShines;
+}
+
+// This object's out-of-line copy of SMS_getShineID is replaced by the mod's
+// (SMS_PATCH_B at retail 0x80175AF8, its first instruction); the mod's
+// returns an s32 and every caller sign-extends the low half. Retail calls
+// the copy from selectPrev, selectNext and initData's SMS_isGetShine loop;
+// the call at the end of initData is inlined and keeps the original.
+static inline s16 SelectMenuShineID(u32 stage, u32 scenario, bool is_etc_shine)
+{
+	if (void* sms_mod_t_ = SMS_MOD_SITE(0x80175AF8))
+		return (s16)((s32(*)(u32, u32, bool))sms_mod_t_)(stage, scenario, is_etc_shine);
+	return SMS_getShineID(stage, scenario, is_etc_shine);
+}
+
+// getScenarioNameForSelectScreen reads r31 = the menu and takes no
+// arguments; its result replaces SMSGetMessageData's.
+static inline const char* SelectMenuScenarioName(TSelectMenu* menu, void* fn)
+{
+	SMS_MOD_GPR(31, menu);
+	return ((const char* (*)())fn)();
+}
